{
    "version": "0.2.0",
    "description": "Installs community FPS configs for Deadlock from GitHub, with a preview, backups and restore.",
    "homepage": "https://github.com/alzzzik/deadlock-config-manager",
    "license": "MIT",
    "notes": "Updates come through 'scoop update deadlock-config-manager'. Settings and backups live in %APPDATA%\\DeadlockConfigManager.",
    "architecture": {
        "64bit": {
            "url": "https://github.com/alzzzik/deadlock-config-manager/releases/download/v0.2.0/Deadlock.Config.Manager_0.2.0_x64_portable.zip",
            "hash": ""
        }
    },
    "bin": "deadlock-config-manager.exe",
    "shortcuts": [
        [
            "deadlock-config-manager.exe",
            "Deadlock Config Manager"
        ]
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/alzzzik/deadlock-config-manager/releases/download/v$version/Deadlock.Config.Manager_$version_x64_portable.zip"
            }
        },
        "hash": {
            "url": "$baseurl/SHA256SUMS.txt"
        }
    }
}
