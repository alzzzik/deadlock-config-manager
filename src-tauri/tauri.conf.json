{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deadlock Config Manager",
  "version": "0.5.0",
  "identifier": "com.deadlockconfigmanager.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Deadlock Config Manager",
        "width": 920,
        "height": 760,
        "minWidth": 720,
        "minHeight": 560,
        "backgroundColor": "#0f1012",
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU5M0Q3MDVGMzc2NzEyOTYKUldTV0VtYzNYM0E5NlcyTFBSUElMdERER2cyMnhNaVhROTA1QWFtUWFzRkpLaE1mYll2aHR1OFUK",
      "endpoints": [
        "https://github.com/alzzzik/deadlock-config-manager/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "deadlockcfg"
        ]
      }
    }
  }
}
